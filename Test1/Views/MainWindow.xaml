<Window x:Class="Test1.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:core="clr-namespace:Test1.Core"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        prism:ViewModelLocator.AutoWireViewModel="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="6*"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <telerik:RadButton Grid.Column="0" Width="110" Height="50" Content="ایجاد" Command="{Binding Add}"/>
            <telerik:RadButton Grid.Column="1" Width="110" Height="50" Content="ویرایش" />
            <telerik:RadButton Grid.Column="2" Width="110" Height="50" Content="حذف"/>
            <telerik:RadButton Grid.Column="3" Width="110" Height="50" Content="جست و جو" Command="{Binding Search}"/>
            <telerik:RadButton Grid.Column="4" Width="110" Height="50" Content="خروج" >
                <b:Interaction.Triggers>
                    <b:EventTrigger EventName="Click">
                        <b:InvokeCommandAction Command="{Binding ExitCommand}" />
                    </b:EventTrigger>
                </b:Interaction.Triggers>
            </telerik:RadButton>
        </Grid>
        <Grid Grid.Row="1">
            <ContentControl prism:RegionManager.RegionName="{x:Static core:NameOfRegion.AddRegion}" Visibility="{Binding AddSectionVisibility}" />
            <ContentControl prism:RegionManager.RegionName="{x:Static core:NameOfRegion.SearchRegion}" Visibility="{Binding SearchSectionVisibility}" />
        </Grid>
    </Grid>
</Window>
